# Public site and authentication
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me

# Supabase authentication and server-side workspace storage
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me-in-production

# First release: inline runs serially inside one long-lived web process.
# Future scale: set bullmq and configure the TCP Redis values below.
ANALYSIS_EXECUTION_MODE=inline
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional distributed rate limiting. Without it, one-instance memory limits apply.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Report generation
GEMINI_API_KEY=

# Exact comma-separated origins allowed to call /api/ext/*
# Example: chrome-extension://abcdefghijklmnop
EXTENSION_ALLOWED_ORIGINS=

# Optional private support channel shown on /support
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional runtime error monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
