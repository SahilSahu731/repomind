# -----------------------------------------------------------------------------
# Site + NextAuth
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Generate separately:
# openssl rand -base64 48
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
SERVER_ENCRYPTION_KEY=replace-with-a-separate-32-plus-character-secret

# -----------------------------------------------------------------------------
# GitHub App
#
# Use TWO GitHub Apps:
#   RepoMind Dev
#   RepoMind Production
#
# Local callback:
# http://localhost:3000/api/auth/callback/github
#
# Local setup URL:
# http://localhost:3000/api/github/install/callback
#
# Production equivalents:
# https://YOUR_DOMAIN/api/auth/callback/github
# https://YOUR_DOMAIN/api/github/install/callback
#
# Webhook:
# https://YOUR_PUBLIC_DOMAIN/api/github/webhook
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=repomind-dev

# Real multiline PEM OR \n escaped PEM both work.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Local development defaults to the file-backed workspace so an unavailable
# remote project cannot break GitHub login. Set to supabase to test migrations.
WORKSPACE_DATABASE_MODE=local

# Kept for compatibility with existing project config if used elsewhere.
DATABASE_URL=
DIRECT_URL=

# -----------------------------------------------------------------------------
# Analysis execution
#
# Local:
# ANALYSIS_EXECUTION_MODE=inline
#
# Production:
# ANALYSIS_EXECUTION_MODE=bullmq
# -----------------------------------------------------------------------------
ANALYSIS_EXECUTION_MODE=inline

# Preferred.
# BullMQ requires a normal Redis protocol connection.
REDIS_URL=

# Fallback if REDIS_URL is omitted.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

ANALYSIS_WORKER_CONCURRENCY=2
ANALYSIS_JOB_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Distributed API rate limiting
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# AI
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Extension
#
# Frozen during Phase 1-3.
# -----------------------------------------------------------------------------
EXTENSION_ALLOWED_ORIGINS=
EXTENSION_TOKEN_SECRET=

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SUPPORT_EMAIL=

# -----------------------------------------------------------------------------
# Billing — not part of Phase 1-3 yet
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

RESEND_API_KEY=
