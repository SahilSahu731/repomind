# Production builds default to https://repomind.vercel.app.
# Put an override in .env.production.local only when deploying elsewhere.
# VITE_API_BASE_URL=https://repomind.example.com

# Development builds (`npm run dev` or `npm run build:dev`) already default to
# localhost. Put an override in .env.development.local if the web app uses
# another port.
# VITE_API_BASE_URL=http://localhost:3000
