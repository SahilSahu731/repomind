{
  "name": "repomind-extension",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build && node scripts/verify-build.mjs",
    "build:dev": "tsc --noEmit && vite build --mode development && node scripts/verify-build.mjs dist-dev",
    "package": "npm run build && cd dist && zip -qrFS ../repomind-extension.zip .",
    "test": "node --experimental-strip-types shared/github.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test && node scripts/verify-build.mjs"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "lucide-react": "^0.456.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.30",
    "@types/chrome": "^0.0.304",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.7.0",
    "vite": "^6.3.0"
  }
}
